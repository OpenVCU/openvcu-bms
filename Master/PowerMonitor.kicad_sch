	(text "Attenuation = 1k / (2*(100 + 1k + 3.3k) + 1k) = 1 / 9.8 (0.10204)\nEffective Shunt Gain (AMC1301 @ G=8.2) = 8.2 / 9.8 = 0.83673 V/V\nINA228 Vshunt Max (ADCRANGE=0) = +/-163.84mV -> +/-195.8mV @ R29 (+/-1958A)\nINA228 Vshunt Max (ADCRANGE=1) = +/-40.96mV  -> +/-48.95mV @ R29 (+/-489.5A)"
		(exclude_from_sim no)
		(at 317.246 252.222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "98586566-d22a-4f62-9ba9-2f867e6b0e91")
	)
