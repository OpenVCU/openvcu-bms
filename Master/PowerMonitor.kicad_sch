	(text "Moutmax= (Vinmax*(1k/(470k*4+1k))*8.2)*(33k/5.6k)\nVinmax= 450V\nVoutmax=11.56V\n\n"
		(exclude_from_sim no)
		(at 287.02 118.11 0)
